{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "packages/brain/src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "moduleResolution": "node",
    "allowJs": true
  },
  "include": ["packages/brain/src/**/*"],
  "exclude": ["node_modules", "dist", "packages/brain/src/cli", "packages/brain/scripts", "packages/brain/src/__tests__"]
}
