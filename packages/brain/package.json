{
  "name": "@oraku/brain",
  "version": "1.1.3",
  "description": "Activity pattern detection SDK for institutions",
  "main": "src/index.ts",
  "dependencies": {
    "better-sqlite3": "^12.8.0",
    "cloudflare": "^5.2.0",
    "dotenv": "^17.3.1",
    "lodash": "^4.17.23",
    "moo": "^0.5.3",
    "nearley": "^2.20.1",
    "node-cron": "^4.2.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/lodash": "^4.17.24",
    "@types/moo": "^0.5.10",
    "@types/nearley": "^2.11.5",
    "@types/node": "^25.5.2",
    "@types/node-cron": "^3.0.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "scripts": {
    "build:grammar": "cd ../.. && nearleyc packages/brain/src/detectors/helpers/markers.ne -o packages/brain/src/detectors/helpers/markers.js",
    "build": "pnpm run build:grammar && tsc",
    "prepare": "pnpm run build",
    "build:watch": "tsc --watch",
    "generate": "npx ts-node generate-activity-events.ts",
    "stitch": "npx ts-node src/cli/stitch.ts output/activity_events.json",
    "trace": "npx ts-node src/cli/trace.ts",
    "detect": "npx ts-node src/cli/run-detectors.ts",
    "reminders": "npx ts-node src/cli/generate-reminders.ts",
    "typecheck": "tsc --noEmit",
    "generate:events": "npx ts-node scripts/generate-events.ts",
    "test": "vitest run"
  }
}
