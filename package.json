{
  "name": "oraku-main",
  "version": "0.0.0",
  "private": true,
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "dotenv": "^17.3.1"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "generate": "npx ts-node generate-activity-events.ts",
    "stitch": "npx ts-node src/cli/stitch.ts output/activity_events.json --groupBy=meta.userId",
    "trace": "npx ts-node src/cli/trace.ts",
    "detect": "npx ts-node src/cli/run-detectors.ts",
    "reminders": "npx ts-node src/cli/generate-reminders.ts",
    "typecheck": "tsc --noEmit",
    "generate:events": "npx ts-node scripts/generate-events.ts",
    "test": "vitest run"
  }
}
